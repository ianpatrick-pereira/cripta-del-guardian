  "r_impacto": { "cuadro": [96, 96], "detalle": 4, "reposo": { "fila": 0, "cuadros": 1 }, "muerte": { "fila": 0, "cuadros": 4, "fps": 9 } },
  "r_anillo":  { "cuadro": [96, 96], "detalle": 4, "reposo": { "fila": 0, "cuadros": 2, "fps": 8 }, "muerte": { "fila": 0, "desde": 2, "cuadros": 2, "fps": 4 } },
