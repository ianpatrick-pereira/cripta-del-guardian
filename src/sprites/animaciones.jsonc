    "muerte":  { "fila": 2, "desde": 1, "cuadros": 3, "fps": 3 }
  },
  // La Reina Tejedora (jefe, v0.65): una hoja por fase. Fila 2: herida, pose de ataque y 2 cuadros finales
  // (fases 1 y 2: se transforma en la siguiente, durante el «¡Fase N!»; fase 3: muere).
  //   queen     fase 1, la Reina Tejedora
  //   queen_f2  fase 2, Madre de la Plaga (abdomen reventado, crías y veneno)
  //   queen_f3  fase 3, la Reina Descarnada (esqueleto con fuego rojo)
  "queen":    { "cuadro": [96, 96], "detalle": 4, "reposo": { "fila": 0, "cuadros": 4, "fps": 4 }, "caminar": { "fila": 1, "cuadros": 4, "fps": 9 },
                "herido": { "fila": 2, "cuadros": 2 }, "muerte": { "fila": 2, "desde": 2, "cuadros": 2, "fps": 1.6 } },
  "queen_f2": { "cuadro": [96, 96], "detalle": 4, "reposo": { "fila": 0, "cuadros": 4, "fps": 4 }, "caminar": { "fila": 1, "cuadros": 4, "fps": 9 },
                "herido": { "fila": 2, "cuadros": 2 }, "muerte": { "fila": 2, "desde": 2, "cuadros": 2, "fps": 1.6 } },
  "queen_f3": { "cuadro": [96, 96], "detalle": 4, "reposo": { "fila": 0, "cuadros": 4, "fps": 6 }, "caminar": { "fila": 1, "cuadros": 4, "fps": 12 },
                "herido": { "fila": 2, "cuadros": 2 }, "muerte": { "fila": 2, "desde": 2, "cuadros": 2, "fps": 1.5 } },
  // Ataques de la Reina (v0.65, IA). Se dibujan cuadro a cuadro desde 16b-zonas-de-la-reina.js:
  //   r_red     Red de la Tejedora: reposo = bola que vuela y se abre; caminar = red en el suelo (normal, con veneno); muerte = se rompe
  //   r_saco    Saco de Crías: reposo = vuela, cae, late, se agrieta; muerte = revienta, salen crías, vacío, se deshace
  //   r_gota    Lluvia de Veneno: reposo = araña colgando; caminar = gota que cae; muerte = salpica, charco, charco, se seca
  "r_red":  { "cuadro": [96, 96], "detalle": 4, "reposo": { "fila": 0, "cuadros": 4 }, "caminar": { "fila": 1, "cuadros": 2 }, "muerte": { "fila": 1, "desde": 2, "cuadros": 2 } },
  "r_saco": { "cuadro": [64, 64], "detalle": 4, "reposo": { "fila": 0, "cuadros": 4 }, "muerte": { "fila": 1, "cuadros": 4 } },
