// Hojas de animación: un PNG con varios cuadros del mismo tamaño puestos en filas.
// El build corta la hoja en cuadros; el juego elige el cuadro según lo que hace el personaje.
//   cuadro:  ancho y alto de cada cuadro, en píxeles (máximo 96×96)
//   detalle: píxeles del dibujo por cada píxel normal del juego. Con 2 el dibujo tiene el doble de píxeles
//            y se pinta a la mitad: ocupa lo mismo que antes, pero se ve más fino.
//   reposo, caminar, herido, muerte: en qué fila están (la primera es la 0), desde qué columna («desde»,
//            0 si no se pone), cuántos cuadros y a cuántos cuadros por segundo (fps).
//   cuadro puede medir hasta 96×96 (para que quepan los cuadros de muerte, que van tendidos).
//            «caminar» va al ritmo de los pasos (fps no se usa). «muerte» se reproduce una vez y se queda quieta.
{
  // Caballero dibujado por IA (v0.62; v0.63 a resolución completa: 64×64 y detalle 4). Fila 0: reposo; fila 1: caminar; fila 2: herido + 3 de muerte.
  "knight": {
    "cuadro": [64, 64],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 3 },
    "caminar": { "fila": 1, "cuadros": 8 },
    "herido":  { "fila": 2, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 1, "cuadros": 3, "fps": 6 }
  },
  // Arquera (v0.68, IA con fondo verde, mismo tamaño que el Caballero). Fila 0: reposo; fila 1: caminar; fila 2: herida + 3 de muerte.
  "archer": {
    "cuadro": [64, 64],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 3 },
    "caminar": { "fila": 1, "cuadros": 8 },
    "herido":  { "fila": 2, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 1, "cuadros": 3, "fps": 6 }
  },
  // Asesino (v0.69, IA con fondo verde, mismo tamaño que el Caballero). Fila 0: reposo; fila 1: caminar; fila 2: herido + 3 de muerte.
  "rogue": {
    "cuadro": [64, 64],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 3 },
    "caminar": { "fila": 1, "cuadros": 8 },
    "herido":  { "fila": 2, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 1, "cuadros": 3, "fps": 6 }
  },
  // Esqueleto (v0.64, IA con fondo magenta): arquero del piso 1, Capitán Hueso, esqueletos invocados.
  // Fila 0: reposo; fila 1: caminar; fila 2: herido + 3 de muerte (se deshace en huesos).
  "skel": {
    "cuadro": [76, 66],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 4 },
    "caminar": { "fila": 1, "cuadros": 8 },
    "herido":  { "fila": 2, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 1, "cuadros": 3, "fps": 5 }
  },
  // Murciélago (v0.64): fila 0 aletea en el sitio; fila 1 vuela hacia delante; fila 2 herido + cae al suelo.
  "bat": {
    "cuadro": [68, 48],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 10 },
    "caminar": { "fila": 1, "cuadros": 4, "fps": 12 },
    "herido":  { "fila": 2, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 1, "cuadros": 3, "fps": 6 }
  },
  // Capitán Hueso (v0.64), subjefe del piso 1: el juego lo agranda (s 3.4) y le dibuja el arco largo.
  "captain": {
    "cuadro": [80, 68],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 4 },
    "caminar": { "fila": 1, "cuadros": 4, "fps": 7 },
    "herido":  { "fila": 2, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 1, "cuadros": 3, "fps": 4 }
  },
  // El Guardián de la Cripta (v0.64, rediseño IA): fantasma acorazado con cola de fuego morado. Fila 0 reposo, 1 se desliza, 2 herido + muerte.
  "guardian": {
    "cuadro": [80, 80],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 2, "fps": 3 },
    "caminar": { "fila": 1, "cuadros": 4, "fps": 6 },
    "herido":  { "fila": 2, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 2, "cuadros": 2, "fps": 1.5 }
  },
  // Fase 2 del Guardián (ojos rojos): reposo con los brazos abajo y su cuadro de herido.
  "guardian_furia": { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 2, "fps": 3 }, "herido": { "fila": 0, "desde": 2, "cuadros": 1 } },
  // Ataques del Guardián (v0.64, IA). Se usan cuadro a cuadro desde 37b-poses-del-jefe.js:
  //   reposo  = almas 0, almas 1, espadas 0, espadas 1
  //   caminar = embestida (prepara), embestida (se lanza), salto, golpe al suelo
  //   herido  = invocar 0, invocar 1, furia 0, furia 1
  "guardian_atq": { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 4 }, "caminar": { "fila": 1, "cuadros": 4 }, "herido": { "fila": 2, "cuadros": 4 } },
  // Marcas del Guardián en el suelo: onda del golpe, estela de la embestida (zarpazos en diagonal) y cráter de cada espada.
  "g_onda":   { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 1 }, "muerte": { "fila": 0, "desde": 1, "cuadros": 3, "fps": 5 } },
  "g_estela": { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 2, "fps": 6 }, "muerte": { "fila": 0, "desde": 2, "cuadros": 2, "fps": 2.5 } },
  "g_crater": { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 1 }, "muerte": { "fila": 0, "desde": 1, "cuadros": 3, "fps": 3 } },
  // Armas y ataques de enemigos del piso 1 (v0.64). Los dibujos sueltos solo llevan "detalle".
  // Arcos: verticales, apuntan a la derecha (el juego los gira hacia donde apunta el enemigo).
  "arco_hueso":     { "detalle": 4 },
  "arco_capitan":   { "detalle": 4 },
  // Flechas: dibujadas en diagonal (punta arriba a la derecha); el juego suma 45° al girarlas.
  "flecha_hueso":   { "detalle": 4 },
  "flecha_capitan": { "detalle": 4 },
  // Orbe de energía en blanco y gris: el juego lo tiñe del color de cada ataque. reposo = late; muerte = estalla.
  "orbe": {
    "cuadro": [62, 62],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 8 },
    "muerte":  { "fila": 1, "cuadros": 4, "fps": 14 }
  },
  // Efectos de los 5 ataques del Guardián (v0.64). "reposo" = aviso o vuelo; "muerte" = el golpe (se ve una vez).
  "g_alma":    { "cuadro": [64, 64], "detalle": 4, "reposo": { "fila": 0, "cuadros": 2, "fps": 8 } },
  "g_impacto": { "cuadro": [64, 64], "detalle": 4, "reposo": { "fila": 0, "cuadros": 1 }, "muerte": { "fila": 0, "cuadros": 4, "fps": 11 } },
  "g_puas":    { "cuadro": [64, 64], "detalle": 4, "reposo": { "fila": 0, "cuadros": 1 }, "muerte": { "fila": 0, "desde": 1, "cuadros": 2, "fps": 4 } },
  "g_espada":  { "cuadro": [64, 64], "detalle": 4, "reposo": { "fila": 0, "cuadros": 1 }, "muerte": { "fila": 0, "desde": 1, "cuadros": 3, "fps": 7 } },
  "g_runas":   { "cuadro": [64, 64], "detalle": 4, "reposo": { "fila": 0, "cuadros": 2, "fps": 6 }, "muerte": { "fila": 0, "desde": 2, "cuadros": 2, "fps": 6 } },
  // Elementales (v0.64). Señor de las Brasas: fila 2 = destello blanco (no se usa: el juego hace su propio destello), herido, muerte.
  "elem_fire": {
    "cuadro": [96, 96],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 6 },
    "caminar": { "fila": 1, "cuadros": 4, "fps": 7 },
    "herido":  { "fila": 2, "desde": 1, "cuadros": 1 },
    "muerte":  { "fila": 2, "desde": 2, "cuadros": 2, "fps": 2 }
  },
  // Poderes del Señor de las Brasas (v0.64)
  "f_bola":    { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 2, "fps": 8 } },
  "f_aliento": { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 3, "fps": 10 } },
  "f_meteoro": { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 2, "fps": 6 }, "muerte": { "fila": 0, "desde": 2, "cuadros": 2, "fps": 3 } },
  "f_linea":   { "cuadro": [80, 80], "detalle": 4, "reposo": { "fila": 0, "cuadros": 1 }, "muerte": { "fila": 0, "desde": 1, "cuadros": 3, "fps": 6 } },
  // Elementales de agua, aire y tierra (v0.64): hojas en una sola fila de 12 cuadros (el 9.º es un destello que no se usa)
  "elem_water": {
    "cuadro": [80, 80],
    "detalle": 4,
    "reposo":  { "fila": 0, "cuadros": 4, "fps": 5 },
    "caminar": { "fila": 0, "desde": 4, "cuadros": 4, "fps": 7 },
    "herido":  { "fila": 0, "desde": 9, "cuadros": 1 },
