  // Ataques del limo y la Matriarca (v0.65, IA, fondo magenta)
  // Orbe ácido: los hilos caen abajo a la izquierda, así que vuela hacia arriba a la derecha (el juego suma 45° al girarlo).
  "l_orbe":     { "cuadro": [64, 64], "detalle": 4, "reposo": { "fila": 0, "cuadros": 4, "fps": 8 } },
