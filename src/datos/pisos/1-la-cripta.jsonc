// Piso 1. Cambia estos valores para diseñar el piso; no hace falta tocar código.
{
  "piso": 1,
  "nombre": "La Cripta",
  // enemigos de las salas cerca de la entrada y de las salas del fondo (ids de src/js/01b-enemigos/).
  // Cada oleada saca enemigos al azar de la lista: repetir un id lo hace más frecuente.
  "enemigosCerca": ["slime", "slime", "bat", "archer"],
  "enemigosLejos": ["slime", "bat", "archer", "archer", "brute"],
  // jefe del piso (id de src/js/01e-jefes/)
  "jefe": "guardian",
  // probabilidad de que cada enemigo salga élite (0.1 = 10 %); la dificultad suma la suya
  "elites": 0.1,
  // terror: más oscuridad, latidos con poca vida y música de miedo
  "terror": false,
  // luz alrededor del jugador: radio totalmente iluminado, radio donde ya es noche y lo oscura que es (0 a 1)
  "luz": { "clara": 150, "hastaNoche": 560, "oscuridad": 0.72 },
  // música: nota base (número MIDI) y velocidad en pulsos por minuto
  "musica": { "nota": 45, "tempo": 96 },
  // colores del suelo y de los muros
  "colores": {
    "sueloA": "#24222e", "sueloB": "#272532", "grietas": "#1c1a24", "manchas": "#2d2a39",
    "muroArriba": "#3f3852", "muroFrente": "#2a2438", "muroBorde": "#5a5070"
  },
  // lo que rodea la mazmorra (sombra morada): fondo, manchas [caliente, media, fría], placas que flotan y su borde,
  // puntitos de luz, burbujas, llamas en los bordes (null = sin llamas), vapor y cuánta luz propia da (0 a 1)
  "mar": {"fondo": "#0b0812", "manchas": ["#6a4aa8", "#3a2560", "#1c1230"], "costra": "rgba(6,4,10,.8)", "grietas": "rgba(150,110,220,.3)", "chispas": ["rgba(210,190,255,.45)", "rgba(150,110,220,.4)"], "burbujas": "#4a3278", "llamas": null, "vapor": "#b8a8d8", "luz": 0.22},
  // decoración: colores de antorchas, brillos, estandartes, plantas (oscura y clara), flores y charcos;
  // partículas que flotan (polvo, esporas, brasas, nieve, luciernagas, chispas o petalos) y la viñeta de los bordes
  "ambiente": {
    "antorchas": "#ffb347", "brillo": "#b98cff", "estandartes": "#4a2a6a", "plantas": ["#2f4a34", "#4f7a4a"],
    "flores": "#c9a6ff", "charcos": "rgba(70,80,130,.32)", "particulas": "polvo", "vineta": "rgba(24,10,40,.55)",
    // cada cuántas casillas hay una antorcha en el muro de arriba; probabilidad de telarañas y de enredaderas
    "antorchaCada": 5, "telaranas": 0.6, "enredaderas": 0.12,
    // cuánta decoración hay junto a los muros y en el resto del suelo (0 a 1), y de qué tipo (más peso = más frecuente).
    // tipos: huesos, velas, cristales, musgo, hierba, charcos, runas, hongos, espinas, escarcha, lava, flores, vidrios, rosas
    "densidadBordes": 0.14, "densidadCentro": 0.07,
    "bordes": { "huesos": 2, "velas": 1, "cristales": 1, "musgo": 2 },
    "centro": { "hierba": 2, "musgo": 2, "charcos": 1, "runas": 0.4 }
  }
}
