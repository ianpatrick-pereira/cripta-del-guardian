// Piso 6. Cambia estos valores para diseñar el piso; no hace falta tocar código.
{
  "piso": 6,
  "nombre": "Jardín de Raíces",
  // enemigos de las salas cerca de la entrada y de las salas del fondo (ids de src/js/01b-enemigos/).
  // Cada oleada saca enemigos al azar de la lista: repetir un id lo hace más frecuente.
  "enemigosCerca": ["splitter", "burrower", "spider", "toxic"],
  "enemigosLejos": ["splitter", "burrower", "priest", "spider", "charger"],
  // jefe del piso (id de src/js/01e-jefes/)
  "jefe": "rootmother",
  // probabilidad de que cada enemigo salga élite (0.1 = 10 %); la dificultad suma la suya
  "elites": 0.22,
  // terror: más oscuridad, latidos con poca vida y música de miedo
  "terror": false,
  // luz alrededor del jugador: radio totalmente iluminado, radio donde ya es noche y lo oscura que es (0 a 1)
  "luz": { "clara": 125, "hastaNoche": 460, "oscuridad": 0.86 },
  // música: nota base (número MIDI) y velocidad en pulsos por minuto
  "musica": { "nota": 40, "tempo": 98 },
  // colores del suelo y de los muros
  "colores": {
    "sueloA": "#1a2116", "sueloB": "#1d2519", "grietas": "#121810", "manchas": "#24301e",
    "muroArriba": "#34442a", "muroFrente": "#22301c", "muroBorde": "#5a7a3a"
  },
  // decoración: colores de antorchas, brillos, estandartes, plantas (oscura y clara), flores y charcos;
  // partículas que flotan (polvo, esporas, brasas, nieve, luciernagas, chispas o petalos) y la viñeta de los bordes
  "ambiente": {
    "antorchas": "#ffe27a", "brillo": "#c8ff7a", "estandartes": "#3a5a2a", "plantas": ["#3f6a2a", "#6aa040"],
    "flores": "#ff9ad8", "charcos": "rgba(60,110,140,.3)", "particulas": "luciernagas", "vineta": "rgba(6,24,10,.5)",
    // cada cuántas casillas hay una antorcha en el muro de arriba; probabilidad de telarañas y de enredaderas
    "antorchaCada": 6, "telaranas": 0.3, "enredaderas": 0.45,
    // cuánta decoración hay junto a los muros y en el resto del suelo (0 a 1), y de qué tipo (más peso = más frecuente).
    // tipos: huesos, velas, cristales, musgo, hierba, charcos, runas, hongos, espinas, escarcha, lava, flores, vidrios, rosas
    "densidadBordes": 0.34, "densidadCentro": 0.26,
    "bordes": { "hongos": 2, "flores": 3, "musgo": 2, "hierba": 2 },
    "centro": { "hierba": 5, "flores": 4, "musgo": 2, "charcos": 1 }
  }
}
