// Piso 2. Cambia estos valores para diseñar el piso; no hace falta tocar código.
{
  "piso": 2,
  "nombre": "Catacumbas Pútridas",
  // enemigos de las salas cerca de la entrada y de las salas del fondo (ids de src/js/01b-enemigos/).
  // Cada oleada saca enemigos al azar de la lista: repetir un id lo hace más frecuente.
  "enemigosCerca": ["toxic", "spider", "archer", "mage"],
  "enemigosLejos": ["toxic", "spider", "mage", "archer", "brute"],
  // jefe del piso (id de src/js/01e-jefes/)
  "jefe": "queen",
  // probabilidad de que cada enemigo salga élite (0.1 = 10 %); la dificultad suma la suya
  "elites": 0.16,
  // terror: más oscuridad, latidos con poca vida y música de miedo
  "terror": false,
  // luz alrededor del jugador: radio totalmente iluminado, radio donde ya es noche y lo oscura que es (0 a 1)
  "luz": { "clara": 130, "hastaNoche": 470, "oscuridad": 0.82 },
  // música: nota base (número MIDI) y velocidad en pulsos por minuto
  "musica": { "nota": 40, "tempo": 104 },
  // colores del suelo y de los muros
  "colores": {
    "sueloA": "#1f2622", "sueloB": "#222a25", "grietas": "#171d19", "manchas": "#29332c",
    "muroArriba": "#38483b", "muroFrente": "#26322a", "muroBorde": "#55705a"
  }
}
