// Piso 4. Cambia estos valores para diseñar el piso; no hace falta tocar código.
{
  "piso": 4,
  "nombre": "Osario Helado",
  // monstruo del piso (id de src/js/01b-enemigos/). Desde v0.55 cada piso tiene UN solo tipo;
  // las dos listas siguen existiendo por si un piso quiere mezclar (cerca de la entrada / salas del fondo).
  "enemigosCerca": ["warden"],
  "enemigosLejos": ["warden"],
  // jefe del piso (id de src/js/01e-jefes/)
  "jefe": "ossuary",
  // probabilidad de que cada enemigo salga élite (0.1 = 10 %); la dificultad suma la suya
  "elites": 0.18,
  // terror: más oscuridad, latidos con poca vida y música de miedo
  "terror": false,
  // luz alrededor del jugador: radio totalmente iluminado, radio donde ya es noche y lo oscura que es (0 a 1)
  "luz": { "clara": 140, "hastaNoche": 520, "oscuridad": 0.8 },
  // música: nota base (número MIDI) y velocidad en pulsos por minuto
  "musica": { "nota": 43, "tempo": 92 },
  // colores del suelo y de los muros
  "colores": {
    "sueloA": "#1c222c", "sueloB": "#1f2631", "grietas": "#141920", "manchas": "#26303c",
    "muroArriba": "#3a4a5e", "muroFrente": "#243040", "muroBorde": "#6a8aa8"
  },
  // lo que rodea la mazmorra (agua helada): fondo, manchas [caliente, media, fría], placas que flotan y su borde,
  // puntitos de luz, burbujas, llamas en los bordes (null = sin llamas), vapor y cuánta luz propia da (0 a 1)
  // forma de las baldosas del suelo: losas, piedra, grandes, hielo, rejilla, raices, mosaico o carne
  "baldosa": "hielo",
  "mar": {"fondo": "#05101a", "manchas": ["#5fa8d3", "#1b4a6b", "#0b2236"], "costra": "rgba(170,205,230,.22)", "grietas": "rgba(190,230,255,.4)", "chispas": ["rgba(230,245,255,.6)", "rgba(150,200,240,.45)"], "burbujas": "#1d4a6a", "llamas": null, "vapor": "#dceaf5", "luz": 0.25},
  // decoración: colores de antorchas, brillos, estandartes, plantas (oscura y clara), flores y charcos;
  // partículas que flotan (polvo, esporas, brasas, nieve, luciernagas, chispas o petalos) y la viñeta de los bordes
  "ambiente": {
    "antorchas": "#ffc27a", "brillo": "#8ad8ff", "estandartes": "#2a4a6a", "plantas": ["#4a5e72", "#8aaac8"],
    "flores": "#cfeaff", "charcos": "rgba(150,200,255,.22)", "particulas": "nieve", "vineta": "rgba(6,18,36,.55)",
    // cada cuántas casillas hay una antorcha en el muro de arriba; probabilidad de telarañas y de enredaderas
    "antorchaCada": 5, "telaranas": 0.3, "enredaderas": 0,
    // cuánta decoración hay junto a los muros y en el resto del suelo (0 a 1), y de qué tipo (más peso = más frecuente).
    // tipos: huesos, velas, cristales, musgo, hierba, charcos, runas, hongos, espinas, escarcha, lava, flores, vidrios, rosas
    "densidadBordes": 0.15, "densidadCentro": 0.08,
    "bordes": { "cristales": 3, "huesos": 3 },
    "centro": { "escarcha": 3, "charcos": 1, "hierba": 1 }
  }
}
