  // src/datos/pisos/
  "La Cripta": "The Crypt",
  "Catacumbas Pútridas": "Putrid Catacombs",
  "El Abismo": "The Abyss",
  "Osario Helado": "Frozen Ossuary",
  "Forja Hundida": "Sunken Forge",
