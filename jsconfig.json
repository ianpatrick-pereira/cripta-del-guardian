{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false
  },
  "include": ["src/js/**/*.js", "src/datos/*.d.ts", "src/tipos/*.d.ts", "src/textos/*.d.ts", "src/sprites/*.d.ts"]
}
